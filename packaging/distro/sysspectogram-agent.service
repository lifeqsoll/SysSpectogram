[Unit]
Description=SysSpectogram integrity agent
Documentation=https://github.com/lifeqsoll/SysSpectogram/blob/main/docs/AGENT_PROTECT.md
After=network.target

[Service]
Type=simple
# Prefer eBPF; agent falls back to mode=userspace/proc if attach fails (visible in journal).
ExecStart=/usr/bin/sysspectogram-agent --mode ebpf --phoenix \
  --socket /run/sysspectogram/agent.sock \
  --pidfile /run/sysspectogram/agent.pid \
  --hmac-secret /var/lib/sysspectogram/state/agent_hmac.secret \
  --guard-pidfile /var/lib/sysspectogram/state/guard.pid \
  --watchdog-pidfile /run/sysspectogram/watchdog.pid \
  --host-id %H
RuntimeDirectory=sysspectogram
StateDirectory=sysspectogram
Restart=always
RestartSec=2
WatchdogSec=120
UMask=0077
# Caps required for eBPF attach; without them the binary still runs in userspace/proc.
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_SYS_RESOURCE CAP_SYS_PTRACE
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_RESOURCE CAP_SYS_PTRACE CAP_NET_ADMIN
MemoryDenyWriteExecute=no
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
