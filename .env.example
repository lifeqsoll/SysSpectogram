# Copy to `.env` (gitignored) and fill in values.
#
# Telegram:
#   1. @BotFather → /newbot → TELEGRAM_BOT_TOKEN
#   2. Message the bot /start
#   3. chat_id: https://api.telegram.org/bot<TOKEN>/getUpdates
#      → result[].message.chat.id
#
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required for stable HMAC on Telegram inline buttons across restarts.
TELEGRAM_TOKEN_SECRET=

# Optional HTTPS tunnel URL for the local web UI (Telegram Mini App).
# Restart guard/web after changing. See docs/WEBAPP_RU.md / docs/WEBAPP.md
# WEBAPP_URL=https://xxxx.loca.lt
# WEBAPP_URL=https://xxxx.trycloudflare.com
# WEBAPP_URL=https://xxxx.ngrok-free.app

# Optional SIEM webhook HMAC
# SIEM_WEBHOOK_SECRET=

# Edge / Cloudflare (hub) — volumetric DDoS; not a scrubber. See docs/EDGE.md
# Token needs Zone → Zone Settings → Edit. Never commit real values.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=

# Fleet Telegram bot on the admin hub (separate bot recommended). See docs/FLEET.md / FLEET_HUB.md
# FLEET_TELEGRAM_BOT_TOKEN=
# FLEET_TELEGRAM_CHAT_ID=
# Comma-separated Telegram chat and/or user IDs allowed to drive the fleet bot.
# When set, all other chats/users are rejected. If unset, only FLEET_TELEGRAM_CHAT_ID is accepted.
# FLEET_TELEGRAM_ALLOW_USERS=
