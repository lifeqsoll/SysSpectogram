# Скопируй в .env и заполни (файл .env в git не попадёт).
#
# 1) BotFather → /newbot → получишь TELEGRAM_BOT_TOKEN
# 2) Напиши боту /start
# 3) chat_id: открой https://api.telegram.org/bot<TOKEN>/getUpdates
#    после сообщения боту — возьми result[].message.chat.id

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# обязательно для стабильных HMAC inline-кнопок между рестартами:
TELEGRAM_TOKEN_SECRET=
# опционально: HMAC для SIEM webhook
# SIEM_WEBHOOK_SECRET=
