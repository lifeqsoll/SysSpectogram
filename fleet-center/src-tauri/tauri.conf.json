{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SysSpectogram Fleet Hub",
  "version": "1.3.1",
  "identifier": "org.sysspectogram.fleethub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SysSpectogram Fleet Hub",
        "width": 1100,
        "height": 780,
        "minWidth": 800,
        "minHeight": 560,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "dmg",
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Fleet Hub for SysSpectogram multi-VPS ops",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
