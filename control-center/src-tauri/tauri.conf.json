{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SysSpectogram Control Center",
  "version": "1.0.0",
  "identifier": "org.sysspectogram.controlcenter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SysSpectogram Control Center",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "Utility",
    "shortDescription": "Desktop control for SysSpectogram host protection",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
